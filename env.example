# ═══════════════════════════════════════════════════════════════════════════════
# QUICKBASE CHAT - ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control!

# ═══════════════════════════════════════════════════════════════════════════════
# AZURE ACTIVE DIRECTORY
# Get these from: Azure Portal → Azure Active Directory → App registrations
# ═══════════════════════════════════════════════════════════════════════════════
AZURE_AD_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_AD_CLIENT_SECRET=your-client-secret-value
AZURE_AD_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ═══════════════════════════════════════════════════════════════════════════════
# QUICKBASE CONFIGURATION
# Get realm from your QuickBase URL: https://[REALM].quickbase.com
# Get App ID from the URL when viewing your app: https://realm.quickbase.com/db/[APP_ID]
# ═══════════════════════════════════════════════════════════════════════════════
QUICKBASE_REALM=yourcompany
QUICKBASE_APP_ID=bqxxxxxxx
QUICKBASE_USER_TOKEN=your-user-token-for-schema-discovery

# ═══════════════════════════════════════════════════════════════════════════════
# ANTHROPIC CLAUDE AI (Primary)
# Get your API key from: https://console.anthropic.com/
# Using Claude Opus 4 for best reasoning and reliability
# ═══════════════════════════════════════════════════════════════════════════════
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# ═══════════════════════════════════════════════════════════════════════════════
# GOOGLE GEMINI AI (Backup - optional)
# Get your API key from: https://aistudio.google.com/apikey
# ═══════════════════════════════════════════════════════════════════════════════
GOOGLE_API_KEY=your-google-api-key-here

# ═══════════════════════════════════════════════════════════════════════════════
# DATABASE (Azure PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# Get this from: Azure Portal → Your PostgreSQL Server → Connection strings
# ═══════════════════════════════════════════════════════════════════════════════
DATABASE_URL=postgresql://adminuser:YourPassword123@yourserver.postgres.database.azure.com:5432/quickbasechat?sslmode=require

# ═══════════════════════════════════════════════════════════════════════════════
# NEXTAUTH CONFIGURATION
# Generate secret with: openssl rand -base64 32
# ═══════════════════════════════════════════════════════════════════════════════
NEXTAUTH_SECRET=generate-a-random-32-character-string-here
NEXTAUTH_URL=http://localhost:3000

# ═══════════════════════════════════════════════════════════════════════════════
# OPTIONAL: Application Settings
# ═══════════════════════════════════════════════════════════════════════════════
# Set to "development" for local testing, "production" for Azure
NODE_ENV=development

