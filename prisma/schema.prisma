// Prisma Schema for QuickBase Chat Application
// This schema defines the database structure for storing users, conversations, and messages

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════════════════════
// USER & AUTHENTICATION
// ═══════════════════════════════════════════════════════════════════════════════

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  
  // QuickBase specific fields
  quickbaseUserId   String?
  quickbaseRealm    String?
  quickbaseToken    String?   @db.Text  // Encrypted QB user token
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  conversations Conversation[]

  @@index([email])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ═══════════════════════════════════════════════════════════════════════════════
// CONVERSATIONS & MESSAGES
// ═══════════════════════════════════════════════════════════════════════════════

model Conversation {
  id        String   @id @default(cuid())
  title     String   @default("New Conversation")
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId])
  @@index([createdAt])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           String   // "user" or "assistant"
  content        String   @db.Text
  
  // Metadata for AI responses
  quickbaseQuery String?  @db.Text  // The QB query that was executed
  queryResults   String?  @db.Text  // JSON stringified results from QB
  
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════════════════════════
// RAG - QUERY EXAMPLES & EMBEDDINGS
// Used for retrieval-augmented generation to improve query accuracy
// ═══════════════════════════════════════════════════════════════════════════════

model QueryExample {
  id          String   @id @default(cuid())
  
  // The natural language question pattern
  question    String   @db.Text
  
  // The correct QuickBase query for this question
  query       String   @db.Text
  
  // Which table this query targets
  tableName   String?
  tableId     String?
  
  // Category for organizing examples
  category    String   @default("general")  // e.g., "enrollment", "staff", "families"
  
  // Description of what this query does
  description String?  @db.Text
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([tableName])
}

// Store document chunks for RAG (QuickBase docs, schema info, etc.)
model Document {
  id          String   @id @default(cuid())
  
  // Document content
  content     String   @db.Text
  
  // Source of the document
  source      String   @default("quickbase_docs")  // "quickbase_docs", "schema", "examples"
  
  // Title or identifier
  title       String?
  
  // Metadata as JSON
  metadata    String?  @db.Text
  
  createdAt   DateTime @default(now())

  @@index([source])
}

// ═══════════════════════════════════════════════════════════════════════════════
// VERIFIED Q&A - Human-verified question/answer pairs for training
// These are gold-standard examples the AI can learn from
// ═══════════════════════════════════════════════════════════════════════════════

model VerifiedQA {
  id              String   @id @default(cuid())
  
  // The natural language question
  question        String   @db.Text
  
  // The correct/expected answer (natural language)
  expectedAnswer  String   @db.Text
  
  // Which tool should be called for this question
  expectedTool    String?  // e.g., "count_records", "run_report", "list_records"
  
  // Expected tool parameters as JSON
  expectedParams  String?  @db.Text  // JSON stringified parameters
  
  // The actual data/count that should be returned
  expectedData    String?  @db.Text  // JSON stringified expected result
  
  // Category for organizing examples
  category        String   @default("general")  // "enrollment", "attendance", "reports", "exploration"
  
  // Tags for more granular filtering
  tags            String[] @default([])
  
  // Verification status
  verified        Boolean  @default(false)
  verifiedBy      String?  // Who verified this (email or name)
  verifiedAt      DateTime?
  
  // Notes for context
  notes           String?  @db.Text
  
  // Usage tracking
  usageCount      Int      @default(0)  // How often this example was used
  successCount    Int      @default(0)  // How often it led to correct answers
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([category])
  @@index([verified])
  @@index([expectedTool])
}

// ═══════════════════════════════════════════════════════════════════════════════
// FEEDBACK - User feedback on AI responses for continuous improvement
// ═══════════════════════════════════════════════════════════════════════════════

model ResponseFeedback {
  id              String   @id @default(cuid())
  
  // The original question
  question        String   @db.Text
  
  // The AI's response
  aiResponse      String   @db.Text
  
  // The tool that was called
  toolCalled      String?
  
  // Tool parameters used
  toolParams      String?  @db.Text
  
  // Data returned from QuickBase
  dataReturned    String?  @db.Text
  
  // User feedback
  isCorrect       Boolean?  // null = not rated, true = correct, false = incorrect
  userComment     String?   @db.Text
  
  // If incorrect, what should the answer be?
  correctedAnswer String?   @db.Text
  
  // Who provided feedback
  userId          String?
  userEmail       String?
  
  // Status for review
  status          String   @default("pending")  // "pending", "reviewed", "converted"
  reviewedBy      String?
  reviewedAt      DateTime?
  
  // Link to VerifiedQA if this was converted to a training example
  convertedToQAId String?
  
  createdAt       DateTime @default(now())

  @@index([isCorrect])
  @@index([status])
  @@index([userId])
}

